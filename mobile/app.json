{
  "expo": {
    "name": "Nova Store",
    "slug": "nova-store-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090b0e",
    "primaryColor": "#d8ff45",
    "scheme": "novastore",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090b0e",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "android": {
      "package": "com.novastore.libya",
      "versionCode": 2,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090b0e"
      }
    },
    "ios": {
      "bundleIdentifier": "com.novastore.libya",
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    }
  }
}
