{
  "name": "nova-store-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "doctor": "expo-doctor",
    "assets": "node scripts/generate-assets.js",
    "prebuild:android": "npm run assets && expo prebuild --platform android",
    "build:android": "cd android && ./gradlew assembleRelease",
    "bundle:android": "cd android && ./gradlew bundleRelease",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-font": "~57.0.4",
    "expo-navigation-bar": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "57.0.13",
    "react-test-renderer": "^19.2.3",
    "sharp": "^0.34.3"
  }
}
